{
  "name": "tabby-asciinema-helper",
  "version": "1.1.1",
  "description": "Asciinema terminal session recorder helper plugin for Tabby",
  "author": "YangHeeJong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rareram/sre-toolbox.git",
    "directory": "tabby/asciinema-helper"
  },
  "keywords": [
    "tabby-plugin",
    "asciinema",
    "asciinema-recorder",
    "asciinema-helper",
    "terminal",
    "recorder"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "webpack --mode production",
    "prepublishOnly": "npm run build",
    "deploy": "npm run build && rm -rf \"$HOME/Library/Application Support/tabby/plugins/node_modules/tabby-asciinema-helper\" && mkdir -p \"$HOME/Library/Application Support/tabby/plugins/node_modules/tabby-asciinema-helper\" && cp -r dist package.json README.md \"$HOME/Library/Application Support/tabby/plugins/node_modules/tabby-asciinema-helper/\"",
    "watch": "webpack --mode development --watch"
  },
  "devDependencies": {
    "@angular/common": "^20.3.25",
    "@angular/compiler": "^20.3.25",
    "@angular/core": "^20.3.25",
    "@angular/forms": "^17.3.5",
    "@types/node": "^20.12.7",
    "rxjs": "^7.8.1",
    "tabby-core": "1.0.197-nightly.1",
    "tabby-settings": "1.0.197-nightly.1",
    "tabby-terminal": "1.0.197-nightly.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "peerDependencies": {
    "tabby-core": "*",
    "tabby-settings": "*",
    "tabby-terminal": "*"
  }
}
