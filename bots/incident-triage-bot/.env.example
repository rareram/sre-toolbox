# ==============================================================================
# SRE Incident Triage Bot - Environment Configuration Template
#
# 보안 및 운영 지침:
# 1. 실제 운영 토큰, 비밀번호, 사내 인프라 주소는 Git 저장소에 커밋하지 마십시오.
# 2. 본 템플릿(.env.example)을 복사하여 .env 파일을 생성하고 환경에 맞게 편집하십시오.
# 3. 모든 관측성 및 AI 모델 엔드포인트는 폐쇄망 및 사내 자체 호스팅 환경을 최우선으로 지원합니다.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM 및 생성 AI 추론 백엔드 설정 (LLM Provider Configuration)
# ------------------------------------------------------------------------------
# [유형 A] 로컬 오픈소스(OSS) 서빙 (개발자 로컬 환경 및 단일 GPU 노드)
# - 엔진: Ollama, llama.cpp, LocalAI
# - 인증: 무인증 (더미 API Key 'ollama' 사용)
# - 모델 예시: gemma4:e4b-mlx, gemma2:9b, llama3.1:8b, qwen2.5:7b
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma4:e4b-mlx
LLM_TIMEOUT_SECONDS=30.0

# [유형 B] 사내 자체 호스팅 엔터프라이즈 서빙 (사내 폐쇄망 k8s / 온프레미스 GPU 클러스터)
# - 엔진: vLLM, TGI (Text Generation Inference), SGLang, NVIDIA NIM
# - 인증: 사내 API 게이트웨이 또는 vLLM 서비스 인증 토큰 (Bearer Token)
# - 모델 예시: meta-llama/Llama-3.1-70B-Instruct, Qwen/Qwen2.5-72B-Instruct
# - 설정 예시:
# LLM_PROVIDER=vllm
# LLM_BASE_URL=http://vllm-cluster.internal.corp:8000/v1
# LLM_API_KEY=corp-internal-vllm-secret-token
# LLM_MODEL=meta-llama/Llama-3.1-70B-Instruct
# LLM_TIMEOUT_SECONDS=45.0

# [유형 C] 공용 클라우드 관리형 SaaS (외부 인터넷 연결 허용 환경)
# - 주의: 금융, 제조, 공공 등 망분리/보안 규정이 엄격한 환경에서는 내부 알람 및 IP 정보의 사외 유출에 유의하십시오.
# - OpenAI 예시:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o
#
# - Azure OpenAI 예시:
# LLM_PROVIDER=azure
# LLM_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/your-deployment
# LLM_API_KEY=azure-api-key-here
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ------------------------------------------------------------------------------
# 2. System 1 실시간 판단 모델 설정 (Decision Engine - Laya / Kev / Jev / Rule)
# ------------------------------------------------------------------------------
# 10~30ms 내 단일 순전파(Single Forward Pass)로 도구 선택, 심각도, 긴급 호출을 판정하는 경량 모델

# [일반 옵션 (Standard Settings)]
# - rule: 규칙/정규식 기반 결정 (의존성 제로, 기본값)
# - laya: 사내 호스팅 Laya (ModernBERT ONNX/FastAPI 엔드포인트)
# - kev: Jev wire-compatible HTTP 엔드포인트
DECISION_BACKEND=rule
DECISION_API_URL=http://localhost:8000
DECISION_API_TOKEN=

# [고급 옵션 (Advanced / Expert Settings - 주의: 임의 수정 비권장)]
# - DECISION_MAX_LOOPBACK_HOPS: Laya 판단 신뢰도가 낮을 때 보조 텔레메트리 쿼리를 재수행하는 최대 유계 루프 횟수.
#   * 기본값 1 권장. 값을 2 이상으로 상향 시 장애 시점 텔레메트리 쿼리 폭증 및 봇 응답 지연(최대 10~15초)으로
#     엔지니어의 타임아웃 오인을 유발할 수 있습니다. 0으로 설정 시 루프백 없이 즉시 1차 판단으로 종결합니다.
DECISION_MAX_LOOPBACK_HOPS=1
# - DECISION_LOOPBACK_TIMEOUT_SECONDS: 루프백 1회당 최대 허용 비동기 타임아웃 (초)
DECISION_LOOPBACK_TIMEOUT_SECONDS=1.5
# - DECISION_CONFIDENCE_THRESHOLD: 루프백을 생략하고 즉시 1차 판단으로 확정하기 위한 최소 신뢰도 임계치 (0.0 ~ 1.0)
DECISION_CONFIDENCE_THRESHOLD=0.85

# ------------------------------------------------------------------------------
# 3. 관측성 스택 엔드포인트 및 실제 인증 체계 (Observability Stack)
# ------------------------------------------------------------------------------
# [Grafana] 대시보드 딥링크 및 Alertmanager 알람 규칙 연동
# - 인증: Grafana Service Account Token (glsa_...) 또는 API Key
GRAFANA_URL=http://localhost:3000
GRAFANA_TOKEN=glsa_example_token_here

# [Prometheus] 메트릭 추세(Rate of change), 커넥션 풀, 부하 PromQL 쿼리
# - 오픈소스 Prometheus 자체는 기본적으로 토큰 인증이 없습니다.
# - Case 1 (기본): 사내망/k8s 내부 통신 시 무인증 (URL만 기입)
PROMETHEUS_URL=http://localhost:9090
# - Case 2: 사내 리버스 프록시(Nginx, Apache, Envoy) 또는 Mimir/Grafana Cloud 연동 시 Basic Auth
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=
# - Case 3: Thanos, VictoriaMetrics, OAuth2-Proxy 등 프록시 게이트웨이 연동 시 Bearer Token
PROMETHEUS_BEARER_TOKEN=

# [Loki] 알람 발생 전후 파드/서비스 에러 로그(LogQL) 조회
# - Case 1: 오픈소스 Loki 단일 바이너리/폐쇄망 (무인증)
LOKI_URL=http://localhost:3100
# - Case 2: 멀티테넌트 환경 (테넌트 헤더 X-Scope-OrgID 필요 시 지정, 기본값 fake)
LOKI_TENANT_ID=fake
# - Case 3: 엔터프라이즈 게이트웨이 또는 Grafana Cloud 연동 시 Basic Auth
LOKI_USERNAME=
LOKI_PASSWORD=
# - Case 4: 토큰 인증 프록시 연동 시 Bearer Token
LOKI_BEARER_TOKEN=

# [Pyroscope] CPU/Memory 스파이크 시점의 Continuous Profiling 화염 그래프 조회
# - OSS 기본은 무인증이며, Grafana Cloud Profiles 또는 엔터프라이즈 연동 시 API Key 입력
PYROSCOPE_URL=http://localhost:4040
PYROSCOPE_API_KEY=

# [OpenTelemetry Collector] 봇 자체의 텔레메트리 전송 (OTLP HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=

# ------------------------------------------------------------------------------
# 4. 서버 인벤토리 카탈로그 및 상태 저장소 (Inventory & Storage)
# ------------------------------------------------------------------------------
# CSV 파일 기반 서버 인벤토리 (IP, 호스트, 랙 위치, 역할, 담당자, 점검 가이드 매핑)
INVENTORY_FILE_PATH=config/servers.example.csv

# SQLite 영속 계층 데이터베이스 파일 경로
DATABASE_PATH=triage.db

# 동일 서비스/클러스터 알람을 단일 인시던트로 묶는 윈도우 시간 (초)
CORRELATION_WINDOW_SECONDS=60

# 옵셔널 캐시 저장소 (Redis)
# 지정 시 텔레메트리 쿼리 단기 캐싱(60s TTL) 활성화. 미지정 시 SQLite 단독 모드로 안전 가동
REDIS_URL=

# ------------------------------------------------------------------------------
# 5. 메신저 연동 (Chat Platforms)
# ------------------------------------------------------------------------------
# Microsoft Teams Incoming Webhook URL (단방향 알림용)
TEAMS_WEBHOOK_URL=

# Azure Bot Service 연동 자격증명 (양방향 대화 봇용)
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=

# ------------------------------------------------------------------------------
# 6. 애플리케이션 서버 구동 설정 (App Server)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
